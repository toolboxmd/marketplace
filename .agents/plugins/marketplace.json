{
  "name": "toolboxmd",
  "interface": {
    "displayName": "toolbox.md"
  },
  "plugins": [
    {
      "name": "karpathy-wiki",
      "description": "Auto-maintained LLM wiki based on Andrej Karpathy's pattern.",
      "source": {
        "source": "url",
        "url": "https://github.com/toolboxmd/karpathy-wiki.git"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "use-grok",
      "description": "Delegate research, coding, and reviews to the local Grok Build CLI.",
      "source": {
        "source": "url",
        "url": "https://github.com/toolboxmd/use-grok.git"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "agentsmd",
      "description": "Portable agent rules and deterministic repository version control.",
      "source": {
        "source": "url",
        "url": "https://github.com/toolboxmd/agentsmd.git"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
