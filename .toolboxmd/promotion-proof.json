{
  "schema": 1,
  "repository": "toolboxmd/marketplace",
  "policyPath": ".toolboxmd/promotion-proof.json",
  "maxAgeSeconds": 86400,
  "blocked": [
    "scripts/*",
    "tests/*",
    ".github/*",
    ".toolboxmd/*",
    ".version-policy.json",
    "toolybara/*"
  ],
  "checks": {
    "suite": {
      "argv": [
        "bash",
        "tests/run-all.sh"
      ],
      "inputs": [
        "*"
      ],
      "environment": [
        "python",
        "platform",
        "git",
        "runnerImage",
        "identity",
        "control",
        "candidateTree"
      ],
      "kind": "behavior"
    },
    "generated": {
      "argv": [
        "python3",
        "scripts/toolybara_proof.py",
        "check-generated"
      ],
      "inputs": [
        "*"
      ],
      "environment": [
        "python",
        "platform",
        "git",
        "runnerImage",
        "identity",
        "control",
        "candidateTree"
      ],
      "kind": "artifact"
    }
  },
  "rules": [
    {
      "paths": [
        "catalog.json",
        ".agents/plugins/marketplace.json",
        ".claude-plugin/marketplace.json",
        ".cursor-plugin/marketplace.json",
        ".grok-plugin/marketplace.json",
        "cursor/agentsmd/*",
        "VERSION",
        "CHANGELOG.md",
        "cursor/model-router/*"
      ],
      "checks": [
        "suite",
        "generated"
      ],
      "reason": "Only deterministic enrolled module distribution and one Marketplace patch; selected-module scope is enforced by the trusted adapter."
    }
  ]
}
